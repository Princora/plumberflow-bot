# PlumberFlow — Environment Variables
# Copy this to .env for local runs, and set the same names on Fly with `fly secrets set`.
# NEVER commit .env to git.

# Neon (pooled connection string: host contains "-pooler"). Applied migrations use the direct one.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# WhatsApp Cloud API (Meta Developer Dashboard). Old names WHATSAPP_TOKEN / PHONE_NUMBER_ID also work.
WA_TOKEN=your_system_user_token_here
WA_PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=choose_a_long_random_string
# Meta-approved template used when free text is refused outside the 24-hour window (optional until approved)
WA_FALLBACK_TEMPLATE=

# Telegram. Old names TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID also work.
TELEGRAM_TOKEN=your_telegram_bot_token_here
FOUNDER_CHAT_ID=your_telegram_chat_id_here
# Your own Telegram user id: only this user may press buttons and run /paid, /resolve
FOUNDER_USER_ID=your_telegram_user_id_here
# Pass the same value as secret_token when you call Telegram's setWebhook
TELEGRAM_WEBHOOK_SECRET=choose_a_long_random_string

# Your WhatsApp number (no +) for the WhatsApp admin commands (STATS, PLUMBERS, BROADCAST)
ADMIN_PHONE=

# Claude Haiku: understanding inbound messages
ANTHROPIC_API_KEY=your_anthropic_key_here
